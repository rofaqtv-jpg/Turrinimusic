<!DOCTYPE html>
<html lang="en">

  <head>
    <meta charset="UTF-8">
    <title>Untitled</title>
    

  </head>
    
  <body>
  /* ============================================================  
   data-loader.js — يقرأ محتوى الموقع من ملف data.json  
   ------------------------------------------------------------  
   هذا الملف يجعل موقعك يقرأ الأغاني والفيديوهات والـ Shorts  
   والستوريات من data.json الذي تعدّله عبر لوحة admin.html  
   إذا فشل تحميل data.json لأي سبب، يعمل الموقع بالبيانات  
   الاحتياطية المدمجة تلقائياً دون أي خطأ.  
   ============================================================ */  
  
const TM_DATA = {  
  /* إذا كان index.html و data.json في نفس المستودع على GitHub Pages  
     اترك القيمة 'data.json' كما هي وستعمل تلقائياً.  
     وإلا ضع الرابط الكامل مثل:  
     'https://USERNAME.github.io/REPO/data.json' */  
  dataUrl: 'data.json'  
};  
  
(function () {  
  const mapAudio = (r, i) => ({  
    id: Number(r.id) || (i + 1),  
    title: r.title || '', artist: r.artist || '', duration: r.duration || '0:00',  
    cover: r.cover || '', src: r.src || '', plays: r.plays || '0', likes: r.likes || '0',  
    date: r.date || '', genre: r.genre || '', desc: r.desc || '',  
    tags: Array.isArray(r.tags) ? r.tags : (r.tags || '').split(',').map(s => s.trim()).filter(Boolean),  
    lyrics: r.lyrics || ''  
  });  
  const mapVideo = (r, i) => ({  
    id: Number(r.id) || (i + 1),  
    title: r.title || '', cat: r.cat || 'music', thumb: r.thumb || '',  
    duration: r.duration || '0:00', quality: r.quality || '1080p',  
    views: r.views || '0', date: r.date || '', desc: r.desc || '', videoSrc: r.videoSrc || ''  
  });  
  const mapShort = r => ({ title: r.title || '', thumb: r.thumb || '', video: r.video || '', views: r.views || '0' });  
  const mapStory = (r, i) => ({  
    id: Number(r.id) || (i + 1),  
    name: r.name || '', icon: r.icon || 'fa-music', color: r.color || '#dc2626',  
    slides: [ (r.type === 'image')  
      ? { type: 'image', title: r.title || '', desc: r.desc || '', image: r.media || '' }  
      : { type: 'video', title: r.title || '', desc: r.desc || '', video: r.media || '', poster: r.poster || r.thumb || '' } ]  
  });  
  
  function applyData() {  
    fetch(TM_DATA.dataUrl, { cache: 'no-store' })  
      .then(r => { if (!r.ok) throw new Error(r.status); return r.json(); })  
      .then(d => {  
        if (!d) return;  
        if (d.audio && d.audio.length)   { audioData.length = 0;   d.audio.forEach((r, i) => audioData.push(mapAudio(r, i))); }  
        if (d.videos && d.videos.length) { videosData.length = 0;  d.videos.forEach((r, i) => videosData.push(mapVideo(r, i))); }  
        if (d.shorts && d.shorts.length) { shortsData.length = 0;  d.shorts.forEach(r => shortsData.push(mapShort(r))); }  
        if (d.stories && d.stories.length){ storiesData.length = 0; d.stories.forEach((r, i) => storiesData.push(mapStory(r, i))); }  
        ['renderAudio','renderAudioTrending','renderSmart','renderVideos','renderShorts',  
         'renderStories','renderHomeSide','renderAudioPlaylistNew','renderVideoSidebar','renderTrending']  
          .forEach(fn => { if (typeof window[fn] === 'function') { try { window[fn](); } catch (e) {} } });  
      })  
      .catch(() => { /* فشل التحميل → تبقى البيانات الاحتياطية */ });  
  }  
  
  if (document.readyState === 'loading') {  
    document.addEventListener('DOMContentLoaded', () => setTimeout(applyData, 0));  
  } else {  
    setTimeout(applyData, 0);  
  }  
})();
    
  </body>
  
</html>
